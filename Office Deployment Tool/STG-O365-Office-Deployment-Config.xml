<!-- Office 365 client configuration file sample. To be used for Office 365 ProPlus apps, 
     Office 365 Business apps, Project Pro for Office 365 and Visio Pro for Office 365. 

     For detailed information regarding configuration options visit: http://aka.ms/ODT. 
     To use the configuration file be sure to remove the comments

     The following sample allows you to download and install the 64 bit version of the Office 365 ProPlus apps 
     and Visio Pro for Office 365 directly from the Office CDN using the Current Channel
     settings  -->

<Configuration>
  <!-- Locked to 32-bit architecture to maintain ODBC driver compatibility -->
  <Add OfficeClientEdition="32" Channel="Current">
    <Product ID="O365BusinessRetail">
      <Language ID="en-us" />
    </Product>
  </Add>
  
  <!-- Automatically uninstalls any legacy MSI versions (like old Visio/Project) to prevent side-by-side conflicts -->
  <RemoveMSI />
  
  <Updates Enabled="TRUE" Channel="Current" />
  
  <!-- Ensures the installation runs silently without prompting the user -->
  <Display Level="None" AcceptEULA="TRUE" />
  
  <!-- Automatically closes open Office apps so the installation doesn't hang -->
  <Property Name="FORCEAPPSHUTDOWN" Value="TRUE"/>
  <Property Name="PinIconsToTaskbar" Value="FALSE"/>
  

  <!--  <Updates Enabled="TRUE" Channel="Current" /> -->

  <!--  <Display Level="None" AcceptEULA="TRUE" />  -->

  <!--  <Property Name="AUTOACTIVATE" Value="1" />  -->

</Configuration>
